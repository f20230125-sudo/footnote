# Copy to .env (git-ignored) and paste your own keys. Neither free tier asks for a card.
#
# Groq key: console.groq.com -> API Keys
GROQ_API_KEY=
# Gemini key: aistudio.google.com -> Get API key
GEMINI_API_KEY=

# The Gemini model used as the judge (and as the answerer if there is no Groq key).
# Take a model name from your AI Studio page; the code does not guess one.
GEMINI_MODEL=

# Limits as rpm,tpm,rpd,tpd. Read them from aistudio.google.com/rate-limit.
# Until set, Gemini is held to 5 requests/min and 100 requests/day.
# GEMINI_LIMITS=
# GEMINI_EMBED_LIMITS=
# GEMINI_EMBED_MODEL=gemini-embedding-001

# Groq answerer models, in order of preference (the second takes over when the first's day is spent).
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
# GROQ_LIMITS=30,8000,1000,200000
